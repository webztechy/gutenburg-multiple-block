
{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "multiblock/polaroids-gallery",
  "version": "1.0.0",
  "title": "Polaroids Gallery",
  "category": "r3mi-multi-block",
  "icon": "images-alt2",
  "description": "Create responsive image sliders.",
  "keywords": [
    "slider",
    "images",
    "slideshow"
  ],
  "textdomain": "r3mi-multiple-block",
  "attributes": {
    "images": {
      "type": "array",
      "default": []
    },
    "autoplay": {
      "type": "boolean",
      "default": false
    },
    "autoplaySpeed": {
      "type": "number",
      "default": 3000
    },
    "showArrows": {
      "type": "boolean",
      "default": true
    },
    "showDots": {
      "type": "boolean",
      "default": true
    },
    "loop": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "editorStyle": "file:./index.css"
}
